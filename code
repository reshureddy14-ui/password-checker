"""
Password Strength Checker
--------------------------
A cybersecurity mini-project that evaluates password strength based on:
  - Length
  - Character variety (uppercase, lowercase, digits, special chars)
  - Common/weak password detection
  - Entropy (bits of randomness)
  - Optional: breach check via HaveIBeenPwned API (k-anonymity model)

Run: python password_checker.py
"""

import re
import math
import hashlib
import urllib.request
import urllib.error

# A small sample of extremely common/weak passwords.
# For a real project, replace this with the rockyou.txt wordlist or similar.
COMMON_PASSWORDS = {
    "123456", "password", "123456789", "12345678", "12345",
    "qwerty", "abc123", "password1", "admin", "letmein",
    "welcome", "monkey", "iloveyou", "111111", "123123",
    "dragon", "master", "sunshine", "princess", "football"
}


def calculate_entropy(password: str) -> float:
    """Estimate password entropy in bits based on character pool size."""
    pool = 0
    if re.search(r'[a-z]', password):
        pool += 26
    if re.search(r'[A-Z]', password):
        pool += 26
    if re.search(r'[0-9]', password):
        pool += 10
    if re.search(r'[^a-zA-Z0-9]', password):
        pool += 32  # approx. printable special characters

    if pool == 0:
        return 0.0
    return len(password) * math.log2(pool)


def check_pwned(password: str) -> int:
    """
    Check if password has appeared in known data breaches using the
    HaveIBeenPwned API with k-anonymity (only first 5 chars of SHA-1 hash sent).
    Returns number of times it's been seen, or -1 if the check failed (no internet, etc.)
    """
    try:
        sha1 = hashlib.sha1(password.encode('utf-8')).hexdigest().upper()
        prefix, suffix = sha1[:5], sha1[5:]
        url = f"https://api.pwnedpasswords.com/range/{prefix}"
        req = urllib.request.Request(url, headers={"User-Agent": "PasswordChecker"})
        with urllib.request.urlopen(req, timeout=5) as response:
            data = response.read().decode('utf-8')
        for line in data.splitlines():
            hash_suffix, count = line.split(':')
            if hash_suffix == suffix:
                return int(count)
        return 0
    except (urllib.error.URLError, TimeoutError, Exception):
        return -1


def analyze_password(password: str, check_breach: bool = True) -> dict:
    """Run all checks and return a report dictionary."""
    length = len(password)
    has_lower = bool(re.search(r'[a-z]', password))
    has_upper = bool(re.search(r'[A-Z]', password))
    has_digit = bool(re.search(r'[0-9]', password))
    has_special = bool(re.search(r'[^a-zA-Z0-9]', password))
    is_common = password.lower() in COMMON_PASSWORDS
    entropy = calculate_entropy(password)

    # Scoring system out of 100
    score = 0
    feedback = []

    if length >= 12:
        score += 25
    elif length >= 8:
        score += 15
        feedback.append("Consider using 12+ characters for better security.")
    else:
        feedback.append("Password is too short (minimum 8 characters recommended).")

    variety_count = sum([has_lower, has_upper, has_digit, has_special])
    score += variety_count * 15  # up to 60 points

    if not has_upper:
        feedback.append("Add uppercase letters.")
    if not has_lower:
        feedback.append("Add lowercase letters.")
    if not has_digit:
        feedback.append("Add numbers.")
    if not has_special:
        feedback.append("Add special characters (!@#$%^&* etc.)")

    if entropy >= 60:
        score += 15
    elif entropy >= 40:
        score += 8

    if is_common:
        score = min(score, 10)  # heavily penalize common passwords
        feedback.append("This is a commonly used/leaked password. Avoid it entirely.")

    score = max(0, min(score, 100))

    # Strength rating
    if score >= 80:
        rating = "Very Strong"
    elif score >= 60:
        rating = "Strong"
    elif score >= 40:
        rating = "Moderate"
    elif score >= 20:
        rating = "Weak"
    else:
        rating = "Very Weak"

    breach_count = None
    if check_breach:
        breach_count = check_pwned(password)
        if breach_count > 0:
            feedback.append(f"This password was found in {breach_count:,} known data breaches!")
            rating = "Compromised"
            score = min(score, 10)
        elif breach_count == -1:
            feedback.append("Breach check skipped (no internet connection).")

    return {
        "length": length,
        "has_lower": has_lower,
        "has_upper": has_upper,
        "has_digit": has_digit,
        "has_special": has_special,
        "is_common": is_common,
        "entropy_bits": round(entropy, 2),
        "breach_count": breach_count,
        "score": score,
        "rating": rating,
        "feedback": feedback,
    }


def print_report(password: str, report: dict):
    print("\n" + "=" * 50)
    print(f" PASSWORD STRENGTH REPORT")
    print("=" * 50)
    print(f"Password        : {'*' * len(password)}")
    print(f"Length          : {report['length']}")
    print(f"Lowercase       : {'Yes' if report['has_lower'] else 'No'}")
    print(f"Uppercase       : {'Yes' if report['has_upper'] else 'No'}")
    print(f"Digits          : {'Yes' if report['has_digit'] else 'No'}")
    print(f"Special chars   : {'Yes' if report['has_special'] else 'No'}")
    print(f"Common password : {'Yes ⚠' if report['is_common'] else 'No'}")
    print(f"Entropy         : {report['entropy_bits']} bits")
    if report['breach_count'] is not None and report['breach_count'] >= 0:
        print(f"Found in breaches: {report['breach_count']}")
    print(f"Score           : {report['score']}/100")
    print(f"Rating          : {report['rating']}")
    if report['feedback']:
        print("\nSuggestions:")
        for tip in report['feedback']:
            print(f"  - {tip}")
    print("=" * 50 + "\n")


if __name__ == "__main__":
    print("=== Password Strength Checker ===")
    pwd = input("Enter a password to check: ")
    result = analyze_password(pwd, check_breach=True)
    print_report(pwd, result)
